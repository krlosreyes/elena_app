rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────
    // SPEC-81: Funciones auxiliares de validación.
    //
    // - signedIn(): el caller pasó el access token de Firebase Auth.
    // - isOwner(uid): además, su `uid` coincide con el path/recurso.
    // - withinSizeLimit(): tope de 100.000 CAMPOS por documento.
    //
    //   CORRECCIÓN (auditoría 2026-07-27, verificada contra el emulador):
    //   este comentario decía "tope defensivo de 100KB por documento" y era
    //   FALSO. `request.resource.size()` devuelve el número de CAMPOS del
    //   documento, no su tamaño en bytes. Un test que escribió 150 KB en un
    //   único campo `analytics` pasó la regla sin problema — el documento
    //   tenía 2 campos, y 2 < 100000.
    //
    //   La función se usa en 12 bloques de este archivo, así que la creencia
    //   equivocada estaba propagada por todas las reglas. Lo que de verdad
    //   protege el tamaño en bytes es el límite NATIVO de Firestore: 1 MiB
    //   por documento, que no se puede rebajar desde las reglas — el lenguaje
    //   no expone ninguna función de bytes.
    //
    //   Lo que SÍ aporta esta función, y por eso se conserva: impide el
    //   relleno de claves (escribir decenas de miles de campos basura para
    //   inflar índices y coste de lectura). Contra el abuso por VOLUMEN el
    //   tope real es 1 MiB, y contra el abuso por FRECUENCIA no hay reglas
    //   que valgan: eso se mitiga con App Check y cuotas, no acá.
    // - idMatchesOrAbsent(uid): si el doc trae campo `id`, debe ser
    //   == uid del path. Defensa en profundidad — el mapper canónico
    //   (SPEC-82) escribe `id: uid`; un cliente comprometido que
    //   intentara escribir `id: 'otro-uid'` queda rechazado.
    // ─────────────────────────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function withinSizeLimit() {
      return request.resource.size() < 100000;
    }

    function idMatchesOrAbsent(uid) {
      return !('id' in request.resource.data)
          || request.resource.data.id == uid;
    }

    // 1. users/{userId}: doc principal del usuario.
    //    Lectura/escritura solo del propio dueño + tamaño limitado +
    //    `id` (si presente) debe coincidir con el path.
    //
    //    FIX-DELETE (auditoría 2026-07-27, hallazgo C-03): `allow write`
    //    unificado incluía `withinSizeLimit()`, que llama a
    //    `request.resource.size()`. En una operación DELETE
    //    `request.resource` NO existe → la evaluación de la regla falla →
    //    permission-denied. Es EXACTAMENTE el mismo defecto que el bloque
    //    catch-all de subcolecciones ya documenta y corrige desde el
    //    2026-06-13; el arreglo nunca se propagó hacia arriba, a este
    //    bloque ni a metabolic_cycles / imr_history.
    //
    //    Consecuencia real: `deleteAccount()` envuelve este borrado en un
    //    catch best-effort, así que el fallo era SILENCIOSO y el borrado
    //    del doc raíz quedaba dependiendo por completo de la Cloud
    //    Function `onUserDeleted` — que solo se dispara si `user.delete()`
    //    tuvo éxito. Con `requires-recent-login` (caso frecuente y
    //    explícitamente manejado en el cliente), el usuario quedaba con la
    //    cuenta viva y parte del historial ya borrado. Para un dato de
    //    salud eso es exposición regulatoria (GDPR art. 17, Ley 1581/2012).
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
                   && withinSizeLimit()
                   && idMatchesOrAbsent(userId);
      allow delete: if isOwner(userId);

      // SPEC-149: metabolic_cycles — historial de ciclos metabólicos
      // (Día Metabólico). PK = cycleId (ISO timestamp UTC del startedAt).
      // Validación: cycleId del payload debe coincidir con el path,
      // dailyScore en rango [0, 100] cuando esté presente.
      //
      // FB-01 (2026-07-11): la catch-all `/{allPaths=**}` de más abajo
      // excluye explícitamente este path de su condición de create/update,
      // por lo que esta validación de rango sí se enforza server-side (ver
      // nota completa en el bloque de imr_history, unas líneas más abajo).
      //
      // FIX-DELETE (auditoría 2026-07-27, C-03): create/update se separan
      // de delete. La condición de rango lee `request.resource.data`, que
      // no existe en DELETE — con `allow write` unificado, borrar un ciclo
      // era imposible incluso para su dueño. Ver nota completa en el
      // bloque `users/{userId}` de arriba.
      match /metabolic_cycles/{cycleId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
                     && withinSizeLimit()
                     && request.resource.data.cycleId == cycleId
                     && (
                       !('dailyScore' in request.resource.data)
                       || (
                         request.resource.data.dailyScore is number
                         && request.resource.data.dailyScore >= 0
                         && request.resource.data.dailyScore <= 100
                       )
                     );
        allow delete: if isOwner(userId);
      }

      // SPEC-143: imr_history — historial semanal del IMR longitudinal
      // (SPEC-141). Validación estricta: weekISO del payload debe
      // coincidir con el path, y totalScore debe estar en rango [0, 100].
      //
      // FB-01 (auditoría 2026-07-11, corregido 2026-07-11): la regla
      // catch-all de subcolecciones (`match /{allPaths=**}`) más abajo
      // excluye explícitamente 'metabolic_cycles' e 'imr_history' de su
      // condición de create/update, para que esta validación estricta
      // sea la ÚNICA vía de escritura server-side para ambos paths (antes
      // quedaba neutralizada por la semántica OR entre matches). La
      // validación client-side en BiometricHistoryService y
      // WeeklyImrSnapshotService sigue existiendo como primera línea de
      // defensa; esta regla es ahora la segunda línea real.
      //
      // FIX-DELETE (auditoría 2026-07-27, C-03): mismo desdoblamiento que
      // metabolic_cycles y users/{userId}. Ver nota completa arriba.
      match /imr_history/{weekISO} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
                     && withinSizeLimit()
                     && request.resource.data.weekISO == weekISO
                     && request.resource.data.totalScore is number
                     && request.resource.data.totalScore >= 0
                     && request.resource.data.totalScore <= 100;
        allow delete: if isOwner(userId);
      }

      // Sistema de insignias (2026-07-15): users/{uid}/badges/{badgeId}.
      // Una EarnedBadge es un HECHO PERMANENTE (ver earned_badge.dart) —
      // a diferencia de metabolic_cycles/imr_history (que sí aceptan
      // `update` para correcciones), acá la única operación permitida es
      // `create`. Sin `update` ni `delete`: ni un bug del cliente ni un
      // usuario que manipule la app pueden modificar o borrar una
      // insignia ya otorgada. Esta es la garantía de integridad que pidió
      // Carlos — vive en el servidor, no en la buena fe del cliente.
      //
      // Validación: badgeId del payload debe coincidir con el path, y
      // category debe ser una de la whitelist cerrada (mismo catálogo que
      // BadgeCategory.all en badge_definition.dart) — un cliente
      // comprometido no puede inventar una categoría arbitraria.
      match /badges/{badgeId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
                     && withinSizeLimit()
                     && request.resource.data.badgeId == badgeId
                     && request.resource.data.category in [
                          'racha', 'ayuno', 'sueno', 'hidratacion',
                          'ejercicio', 'nutricion', 'imr', 'checkin',
                          'resiliencia', 'bienvenida'
                        ];
      }

      // Módulo "Tu Glucosa" (23-jul, propuesta
      // documentacion/propuestas/Propuesta_Protocolo_Glucosa_2026-07-23.docx
      // §8/§9): users/{uid}/glucose_readings/{readingId}. Dato de salud
      // SENSIBLE (glucosa capilar) — regla estricta propia, igual
      // criterio que metabolic_cycles/imr_history: la catch-all de más
      // abajo excluye explícitamente este path de create/update para
      // que esta validación de rango sea la única vía de escritura
      // server-side.
      //
      // Sin `update`: una lectura de glucosa es un HECHO medido en un
      // momento — igual criterio de integridad que `badges` (no se
      // "corrige" un valor ya guardado, se borra y se vuelve a crear).
      // Sí se permite `delete` (a diferencia de badges): es un dato de
      // salud personal, el usuario tiene derecho a borrar una lectura
      // mal cargada o a ejercer su derecho de supresión sobre su propio
      // historial (GDPR / Ley 1581 de Colombia, dato sensible).
      //
      // Validación: userId del payload debe coincidir con el dueño,
      // valueMgDl debe ser number en el rango fisiológico plausible
      // [40, 400] (glucose_reading.dart, kGlucoseMinPlausibleMgDl/
      // kGlucoseMaxPlausibleMgDl), y context debe ser uno de los
      // valores reconocidos de GlucoseReadingContext.
      match /glucose_readings/{readingId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
                     && withinSizeLimit()
                     && request.resource.data.userId == userId
                     && request.resource.data.valueMgDl is number
                     && request.resource.data.valueMgDl >= 40
                     && request.resource.data.valueMgDl <= 400
                     && request.resource.data.context in [
                          'ayunas', 'antesDeComer', 'postprandial1h',
                          'postprandial2h', 'antesDeDormir', 'otro'
                        ];
        allow delete: if isOwner(userId);
      }

      // Módulo "Tu Glucosa": users/{uid}/glucose_meta/protocol — estado
      // del protocolo (activo/pausado/consentimiento), mismo patrón que
      // exercise_meta/profile. Sin datos clínicos acá (solo flags de
      // configuración), no necesita validación de rango propia — la
      // catch-all de abajo ya lo cubre con ownership + tamaño.

      // Subcolecciones (logs de sueño, hidratación, ejercicio, etc.):
      // mismo dueño, mismo límite de tamaño. Sin id-match porque los
      // docs hijos pueden o no tener `id` y el path ya enlaza al
      // dueño vía wildcard.
      //
      // BUG-FIX (2026-06-13): `allow write` unificado incluía
      // `withinSizeLimit()` que llama a `request.resource.size()`.
      // En operaciones DELETE `request.resource` no existe → la
      // evaluación falla → permission denied en todos los borrados
      // (sleep, hidratación, ejercicio, etc.).
      // Separamos create/update (necesitan size check) de delete
      // (solo requiere ownership).
      //
      // FB-01 (2026-07-11): 'metabolic_cycles' e 'imr_history' quedan
      // excluidos de create/update aquí a propósito — sus reglas
      // específicas de arriba (líneas ~55-91) son la única vía de
      // escritura válida para esos dos paths, para que la validación de
      // rango [0,100] no quede neutralizada por esta regla más laxa.
      //
      // Insignias (2026-07-15): 'badges' queda excluido de create/update
      // Y de delete — si no lo excluyéramos de delete, esta regla más
      // laxa (que sí permite delete a cualquier dueño) neutralizaría la
      // inmutabilidad que acabamos de definir arriba, por la misma
      // semántica OR entre matches que documenta la nota de FB-01.
      //
      // Glucosa (23-jul): 'glucose_readings' queda excluido de
      // create/update por el mismo motivo — su regla de rango [40,400]
      // de arriba quedaría neutralizada si esta regla más laxa también
      // aplicara. NO se excluye de `delete` (a diferencia de badges):
      // sí debe poder borrarse por esta vía, ver nota arriba.
      match /{allPaths=**} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
                     && withinSizeLimit()
                     && allPaths[0] != 'metabolic_cycles'
                     && allPaths[0] != 'imr_history'
                     && allPaths[0] != 'badges'
                     && allPaths[0] != 'glucose_readings';
        allow delete: if isOwner(userId) && allPaths[0] != 'badges';
      }
    }

    // 2. user_food_suggestions: catálogo global de sugerencias.
    //    FB-02 (auditoría 2026-07-11): sin consumidores activos en el
    //    cliente (grep de `.collection('user_food_suggestions')` en
    //    lib/ = 0 resultados) — se deja lectura abierta a autenticados
    //    por si algún flujo la reactiva, pero la escritura se restringe
    //    a Cloud Functions / rol admin (custom claim) para evitar que
    //    cualquier cuenta autenticada pueda envenenar o hacer spam del
    //    catálogo global. Si esta colección vuelve a poblarse desde la
    //    app, reintroducir aquí una regla de ownership real en vez de
    //    reabrir el write a signedIn().
    match /user_food_suggestions/{docId} {
      allow read: if signedIn();
      allow write: if request.auth.token.admin == true;
    }

    // 3. master_food_db: catálogo maestro de alimentos.
    //    FB-02: mismo criterio que user_food_suggestions — sin
    //    consumidores activos en lib/, escritura restringida a admin.
    match /master_food_db/{docId} {
      allow read: if signedIn();
      allow write: if request.auth.token.admin == true;
    }

    // 4. master_exercises_db: catálogo maestro de ejercicios.
    //    FB-02: mismo criterio — escritura restringida a admin.
    match /master_exercises_db/{docId} {
      allow read: if signedIn();
      allow write: if request.auth.token.admin == true;
    }

    // 5. metamorfosis_posts: contenido público (blog/educativo).
    //    Lectura sin auth. Contenido (título/content/quiz) solo backend/Console.
    //    SPEC-205: el cliente puede actualizar SOLO el mapa `analytics`
    //    (contador de vistas/engagement) y `views` nunca puede bajar. Esto
    //    habilita incrementViews desde la app sin exponer el contenido.
    //
    //    FB-08 (auditoría independiente 2026-07-11): la condición original
    //    leía `resource.data.analytics.views` sin verificar que el campo
    //    `analytics` existiera. Un post creado (vía consola/CMS) sin ese
    //    mapa preseed hacía que la regla lanzara un error de evaluación de
    //    campo inexistente y denegara SIEMPRE la escritura — incrementViews
    //    fallaba en silencio (permission-denied atrapado y logueado como
    //    warning) para ese post, indefinidamente. Se añade el chequeo
    //    `!('analytics' in resource.data)` como vía alterna válida, más
    //    `is number` para blindar el tipo del nuevo valor.
    //    B-18 (auditoría 2026-07-27): la regla permitía a cualquier cuenta
    //    autenticada escribir el mapa `analytics` con dos únicas
    //    restricciones —tocar solo esa clave y no decrecer `views`— y sin
    //    `withinSizeLimit()`. Eso abría dos vectores en un documento
    //    PÚBLICO que después leen todos los usuarios: (a) escribir cientos
    //    de KB de basura en `analytics`, amplificando el coste de lectura
    //    de toda la base; (b) inflar el contador a un valor arbitrario,
    //    corrompiendo las métricas de contenido.
    //
    //    Se añade el límite de tamaño y un tope de incremento: una vista
    //    es +1, así que cualquier salto mayor que 1 por escritura no
    //    proviene de `incrementViews`. Con esto el contador sigue siendo
    //    monótono, pero además avanza al ritmo que le corresponde.
    match /metamorfosis_posts/{postId} {
      allow read: if true;
      allow create, delete: if false;
      allow update: if signedIn()
        && withinSizeLimit()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['analytics'])
        && request.resource.data.analytics.views is number
        && (
          !('analytics' in resource.data)
          || (
            request.resource.data.analytics.views >= resource.data.analytics.views
            && request.resource.data.analytics.views <= resource.data.analytics.views + 1
          )
        );
    }

    // ─────────────────────────────────────────────────────────────────
    // SPEC-263: Retos de constancia (competencia social sana).
    //
    // Modelo de DOS documentos, cada uno con UN SOLO escritor, para que las
    // reglas sean simples y a prueba de balas:
    //   challenges/{code}              → metadata. Crea el dueño; "unirse" =
    //                                    agregarte SOLO a ti a memberIds; borra
    //                                    el dueño.
    //   challenges/{code}/scores/{uid} → tu puntaje. SOLO tú (uid del path).
    //
    // El `code` es el id del doc y actúa como capacidad de invitación:
    // conocerlo permite leer el reto y su tablero (read: signedIn). Los códigos
    // son aleatorios (alfabeto de 31 símbolos), así que enumerarlos es inviable.
    // No se comparten datos de salud crudos — solo un nombre y un puntaje.
    // ─────────────────────────────────────────────────────────────────
    match /challenges/{code} {
      allow read: if signedIn();

      // Crear: el creador es el dueño y el ÚNICO miembro inicial.
      allow create: if signedIn()
        && withinSizeLimit()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds.hasOnly([request.auth.uid])
        && request.resource.data.memberIds.size() == 1;

      // Unirse: SOLO puedes agregarte a ti mismo a memberIds; nada más cambia.
      // (affectedKeys == memberIds → nombre/fechas/dueño inmutables; no estabas
      // dentro; ahora sí; no removiste a nadie; exactamente uno agregado = tú.)
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
        && !(request.auth.uid in resource.data.memberIds)
        && (request.auth.uid in request.resource.data.memberIds)
        && request.resource.data.memberIds.hasAll(resource.data.memberIds)
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1;

      // Borrar: solo el dueño. (Nada de withinSizeLimit/request.resource en
      // DELETE — ver FIX-DELETE arriba.)
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      // Puntaje: cada quien escribe SOLO su propio doc (id == uid).
      match /scores/{uid} {
        allow read: if signedIn();
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && withinSizeLimit();
        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }

    // FIRE-06 (cerrado 22-jul): la regla de la colección plana
    // fasting_history (SPEC-50.4 legacy, TODO-SPEC-217-inc5) se retiró.
    // La colección se confirmó vacía en producción
    // (functions/scripts/verify_fasting_history_migration.js, 0
    // documentos) y se borró en Firestore — ver
    // Addendum_Auditoria_ElenaApp_2026-07-22.docx §2. Toda la data real
    // vive en users/{uid}/fasting_history (subcolección, cubierta por
    // `match /{allPaths=**}` arriba).

    // ─────────────────────────────────────────────────────────────────
    // SPEC-81: Denial-by-default explícito.
    //
    // Firestore deniega por defecto cualquier ruta sin match — esta
    // regla lo hace EXPLÍCITO para que si en el futuro alguien agrega
    // una colección nueva sin escribir su rule, el deploy aún esté
    // protegido. Las rules de arriba ya tienen `allow read/write: if
    // <cond>`; una collection no listada llega aquí y queda en
    // `if false`.
    // ─────────────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
